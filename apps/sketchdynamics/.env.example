# Nebius Token Factory key (https://tokenfactory.nebius.com). Copy to .env; never commit the real one.
NEBIUS_API_KEY=
# Optional overrides
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# MOTION_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# MOTION_EDITOR_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Default planner when the UI doesn't say: super (Nemotron 3 Super 120B, default) or ultra (Nemotron 3 Ultra 550B)
# SKETCHDYNAMICS_PLANNER=super

# Guardrails for a publicly hosted copy (all off when unset); see README "Host a demo"
# SKETCHDYNAMICS_ACCESS_CODE=
# SKETCHDYNAMICS_RATE_LIMIT=30
# SKETCHDYNAMICS_DAILY_TOKENS=2000000
# SKETCHDYNAMICS_BEHIND_PROXY=1

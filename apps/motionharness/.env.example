# Nebius Token Factory key (https://tokenfactory.nebius.com). Copy to .env; never commit the real one.
NEBIUS_API_KEY=
# Token Factory project ID (Project settings, under the project name). Enables the Sandboxes backend.
NEBIUS_PROJECT_ID=
# Tavily (https://tavily.com): doc lookup when a task needs an external API (optional)
TAVILY_API_KEY=
# Optional overrides
# MOTIONHARNESS_SANDBOX=auto        # auto | local | contree
# MOTIONHARNESS_CODER_MODEL=nvidia/nemotron-3-super-120b-a12b
# MOTION_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL

# Hosting a public demo (all off by default); see README "Host a demo"
# MOTIONHARNESS_HOSTED=1            # Sandboxes only, no installing into the server, capped runs
# MOTIONHARNESS_ACCESS_CODE=
# MOTIONHARNESS_RATE_LIMIT=6        # runs + scene trials per visitor per hour
# MOTIONHARNESS_DAILY_TOKENS=3000000
# MOTIONHARNESS_BEHIND_PROXY=1

# Nebius Token Factory key (https://tokenfactory.nebius.com). Copy to .env; never commit the real one.
NEBIUS_API_KEY=
# Bearer token Hermes uses to reach the canvasmind MCP server. Make one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CANVASMIND_MCP_TOKEN=
# The HTTPS hostname the sandbox uses to reach this machine (from `tailscale status`), e.g. my-mac.tailnet-1234.ts.net
CANVASMIND_PUBLIC_HOST=
# Tavily (https://tavily.com): the weekly trend digest
TAVILY_API_KEY=
# Telegram bot (from @BotFather) and the numeric user IDs allowed to talk to it; read by `nemohermes onboard`
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Public demo bot (optional; see README "Run a public demo bot"): a second bot and a second random MCP token
CANVASMIND_TELEGRAM_BOT_TOKEN=
CANVASMIND_DEMO_MCP_TOKEN=

# Optional
# CANVASMIND_HOME=~/CanvasMind          # where the library lives
# CANVASMIND_WATCH=~/Sketches:~/proj/out # folders `scan` files new work from (colon-separated)
# CANVASMIND_PORT=8770
# CANVASMIND_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# MOTION_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# MOTION_EDITOR_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

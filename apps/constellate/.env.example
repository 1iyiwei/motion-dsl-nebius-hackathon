# Nebius Token Factory key (https://tokenfactory.nebius.com). Copy to .env; never commit the real one.
NEBIUS_API_KEY=
# Nebius AI Cloud project ID (project-…, from the console's project picker). Enables the Serverless Jobs simulation sweep;
# the `nebius` CLI must be installed and logged in. Without it, the sweep runs locally.
NEBIUS_CLOUD_PROJECT_ID=
# Tavily (https://tavily.com): site briefing (airspace rules and typical wind for the venue)
TAVILY_API_KEY=
# Optional overrides
# CONSTELLATE_JOB_PLATFORM=cpu-d3
# CONSTELLATE_JOB_PRESET=4vcpu-16gb
# NEBIUS_CLI=~/.nebius/bin/nebius
# The address phones use for the live wind pad (default: the address the page was opened from), e.g.
# CONSTELLATE_PUBLIC_URL=https://my-mac.my-tailnet.ts.net:10000
